#!/bin/bash
# tidaldl installer for macOS (Apple Silicon, arm64) - v@@VERSION@@
# GENERATED by tools/build_installers.py from src/macos.sh.in and tidaldl.py.
# Do not edit this file; edit the sources and rebuild. sources sha256: @@HASH@@
set -e

echo "==> tidaldl installer v@@VERSION@@ (macOS)"

if [ "$(uname -s)" != "Darwin" ]; then
    echo "ERROR: this installer is for macOS. On the phone use install-termux.sh."
    exit 1
fi
if [ "$(uname -m)" != "arm64" ] && [ -z "$TIDALDL_ALLOW_ANY_ARCH" ]; then
    echo "ERROR: Apple Silicon (arm64) only. Found $(uname -m)."
    exit 1
fi

# Homebrew on Apple Silicon lives in /opt/homebrew
if ! command -v brew >/dev/null 2>&1 && [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi
if ! command -v brew >/dev/null 2>&1; then
    echo "ERROR: Homebrew not found. Install it from https://brew.sh first."
    exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
    echo "==> Installing Python 3..."
    brew install python
fi
PYVER=$(python3 -c 'import sys; print("%d%d" % sys.version_info[:2])')
if [ "$PYVER" -lt 310 ]; then
    echo "ERROR: Python 3.10+ required. Found $(python3 --version)."
    exit 1
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
    echo "==> Installing ffmpeg..."
    brew install ffmpeg
fi

if ! command -v pipx >/dev/null 2>&1; then
    echo "==> Installing pipx..."
    brew install pipx
    pipx ensurepath
fi

echo "==> Checking streamrip..."
NEED_SR=1
if command -v rip >/dev/null 2>&1; then
    LATEST=$(curl -fsS https://api.github.com/repos/nathom/streamrip/commits/dev 2>/dev/null \
             | grep -m1 '"sha"' | cut -d'"' -f4 || true)
    INSTALLED=$(pipx runpip streamrip freeze 2>/dev/null \
                | grep -i streamrip | grep -oE '[0-9a-f]{40}' | head -1 || true)
    if [ -n "$LATEST" ] && [ "$LATEST" = "$INSTALLED" ]; then
        echo "==> streamrip already on latest dev commit. Skipping."
        NEED_SR=0
    fi
fi
if [ "$NEED_SR" -eq 1 ]; then
    echo "==> Installing/updating streamrip..."
    pipx install "git+https://github.com/nathom/streamrip.git@dev" --force >/dev/null 2>&1 \
        || pipx upgrade streamrip
fi

DL_DIR="$HOME/Downloads/tidaldl"
echo "==> Creating download folder: $DL_DIR"
mkdir -p "$DL_DIR" "$HOME/.config/tidaldl"

# ---- the command: written beside its name, then renamed over the top ----
INSTALL_DIR="/opt/homebrew/bin"
[ -w "$INSTALL_DIR" ] || INSTALL_DIR="$HOME/.local/bin"
mkdir -p "$INSTALL_DIR"
TARGET="$INSTALL_DIR/tidaldl"
rm -f "$TARGET.new"

cat > "$TARGET.new" << 'PYEOF'
@@TIDALDL_PY@@
PYEOF

chmod +x "$TARGET.new"
python3 -m py_compile "$TARGET.new" 2>/dev/null || { echo "ERROR: the written command does not compile. Nothing was changed."; rm -f "$TARGET.new"; exit 1; }
mv -f "$TARGET.new" "$TARGET"

echo "==> Configuring streamrip..."
"$TARGET" --setup

ZSHRC="$HOME/.zshrc"
PATH_LINE="export PATH=\"$INSTALL_DIR:\$PATH\""
if ! echo ":$PATH:" | grep -q ":$INSTALL_DIR:"; then
    if [ -f "$ZSHRC" ] && grep -qF "$INSTALL_DIR" "$ZSHRC"; then
        echo "==> PATH entry for $INSTALL_DIR already in ~/.zshrc."
    else
        printf '\n# added by tidaldl installer\n%s\n' "$PATH_LINE" >> "$ZSHRC"
        echo "==> Added $INSTALL_DIR to PATH in ~/.zshrc."
        echo "    Run 'source ~/.zshrc' or open a new terminal to use tidaldl."
    fi
fi

echo ""
echo "==> Done. tidaldl v@@VERSION@@ installed to $TARGET"
echo "==> Downloads go to: $DL_DIR  (folders named: Artist - Album (Year))"
echo "==> Next: run  tidaldl  and press  a  once to log in to TIDAL."
