#!/data/data/com.termux/files/usr/bin/bash
# tidaldl installer for Termux (Android) - v@@VERSION@@
# GENERATED by tools/build_installers.py from src/termux.sh.in and tidaldl.py.
# Do not edit this file; edit the sources and rebuild. sources sha256: @@HASH@@
set -e

echo "==> tidaldl installer v@@VERSION@@ (Termux)"

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
if [ -z "$TIDALDL_ALLOW_ANY_HOST" ] && [ ! -d /data/data/com.termux/files ]; then
    echo "ERROR: this installer is for Termux. On a Mac use install-macos.sh."
    exit 1
fi

echo "==> Installing packages (python, ffmpeg, git, build tools)..."
pkg install -y python ffmpeg git termux-tools clang make rust \
    libffi openssl libjpeg-turbo freetype python-pillow >/dev/null

# streamrip lives in its own environment; Pillow comes from the pkg build
VENV="$HOME/.local/share/tidaldl/venv"
if [ ! -x "$VENV/bin/python" ]; then
    echo "==> Creating environment: $VENV"
    mkdir -p "$(dirname "$VENV")"
    python -m venv --system-site-packages "$VENV"
fi

echo "==> Checking streamrip..."
NEED_SR=1
if [ -x "$VENV/bin/rip" ]; then
    LATEST=$(curl -fsS https://api.github.com/repos/nathom/streamrip/commits/dev 2>/dev/null \
             | grep -m1 '"sha"' | cut -d'"' -f4 || true)
    INSTALLED=$("$VENV/bin/pip" freeze 2>/dev/null \
                | grep -i streamrip | grep -oE '[0-9a-f]{40}' | head -1 || true)
    if [ -n "$LATEST" ] && [ "$LATEST" = "$INSTALLED" ]; then
        echo "==> streamrip already on latest dev commit. Skipping."
        NEED_SR=0
    fi
fi
if [ "$NEED_SR" -eq 1 ]; then
    echo "==> Installing/updating streamrip (compiles a few packages, this can take minutes)..."
    "$VENV/bin/pip" install --upgrade "git+https://github.com/nathom/streamrip.git@dev"
fi
mkdir -p "$PREFIX/bin"
ln -sf "$VENV/bin/rip" "$PREFIX/bin/rip"

# Downloads: shared storage if the person has run termux-setup-storage, else home
if [ -d "$HOME/storage/downloads" ]; then
    DL_DIR="$HOME/storage/downloads/tidaldl"
else
    DL_DIR="$HOME/tidaldl"
fi
echo "==> Download folder: $DL_DIR"
mkdir -p "$DL_DIR" "$HOME/.config/tidaldl"

# ---- the command: written beside its name, then renamed over the top ----
TARGET="$PREFIX/bin/tidaldl"
rm -f "$TARGET.new"

cat > "$TARGET.new" << 'PYEOF'
@@TIDALDL_PY@@
PYEOF

# Termux has no /usr/bin/env: point the shebang at its own python
sed -i "1s|.*|#!$PREFIX/bin/python3|" "$TARGET.new"
chmod +x "$TARGET.new"
"$PREFIX/bin/python3" -m py_compile "$TARGET.new" 2>/dev/null || { echo "ERROR: the written command does not compile. Nothing was changed."; rm -f "$TARGET.new"; exit 1; }
mv -f "$TARGET.new" "$TARGET"

echo "==> Configuring streamrip..."
"$TARGET" --setup

echo ""
echo "==> Done. tidaldl v@@VERSION@@ installed to $TARGET"
if [ ! -d "$HOME/storage/downloads" ]; then
    echo "==> To save into the phone's Downloads folder run once:  termux-setup-storage"
    echo "    then run this installer again."
fi
echo "==> Next: run  tidaldl  and press  a  once to log in to TIDAL."
